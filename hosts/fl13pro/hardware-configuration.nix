{ config, lib, pkgs, modulesPath, ... }:
{
  imports = [ ];

  boot.initrd.availableKernelModules = [ "ehci_pci" "ahci" "xhci_pci" "nvme" "usbhid" "sr_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ ];
  boot.extraModulePackages = [ ];

  # TODO: vmware remove
  system.fsPackages = [ pkgs.open-vm-tools ];
  fileSystems."/mnt/hgfs/nixfiles" = {
    device = ".host:/nixfiles";
    fsType = "fuse./run/current-system/sw/bin/vmhgfs-fuse";
    options = [ "umask=22" "uid=1000" "gid=100" "allow_other" "defaults" "auto_unmount" ];
  };

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/75305101-7e99-4cb9-92a3-1511343c3edd";
    fsType = "ext4";
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/8D4E-128A";
    fsType = "vfat";
    options = [ "fmask=0077" "dmask=0077" ];
  };

  swapDevices = [
    { device = "/dev/disk/by-uuid/327c53a1-e91f-48b6-a497-f7348b2aa137"; }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "aarch64-linux";
}
